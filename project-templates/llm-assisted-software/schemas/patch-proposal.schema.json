{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-tools.local/schemas/patch-proposal.schema.json",
  "title": "Patch Proposal",
  "type": "object",
  "required": ["schema_version", "patch_key", "target_file", "base_hash", "proposal_source", "rationale", "changes"],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "patch_key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "target_file": { "type": "string", "minLength": 1 },
    "base_hash": { "type": "string", "minLength": 1 },
    "proposal_source": { "type": "string", "enum": ["web-ui", "cli", "llm", "human"] },
    "rationale": { "type": "string", "minLength": 1 },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["op", "path"],
        "properties": {
          "op": { "type": "string", "enum": ["add", "replace", "remove"] },
          "path": { "type": "string", "minLength": 1 },
          "value": {}
        }
      }
    }
  }
}
