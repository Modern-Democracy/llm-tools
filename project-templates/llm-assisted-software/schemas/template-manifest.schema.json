{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-tools.local/schemas/template-manifest.schema.json",
  "title": "Template Manifest",
  "type": "object",
  "required": ["schema_version", "template_key", "name", "version", "status", "canonical_source", "generated_root", "modules"],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "template_key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[A-Za-z0-9.-]+)?$" },
    "status": { "type": "string", "enum": ["draft", "active", "deprecated"] },
    "description": { "type": "string" },
    "canonical_source": { "type": "string", "enum": ["git_files"] },
    "generated_root": { "type": "string", "minLength": 1 },
    "patch_output": { "type": "string", "minLength": 1 },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key", "required", "path", "summary"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "required": { "type": "boolean" },
          "path": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
