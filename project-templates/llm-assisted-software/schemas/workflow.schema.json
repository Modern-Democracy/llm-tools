{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-tools.local/schemas/workflow.schema.json",
  "title": "Workflow",
  "type": "object",
  "required": ["schema_version", "workflow_key", "purpose", "steps", "stop_conditions", "acceptance_checks"],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "workflow_key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "purpose": { "type": "string", "minLength": 1 },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "action", "output"],
        "properties": {
          "role": { "type": "string", "minLength": 1 },
          "action": { "type": "string", "minLength": 1 },
          "output": { "type": "string", "minLength": 1 }
        }
      }
    },
    "stop_conditions": { "type": "array", "items": { "type": "string" } },
    "acceptance_checks": { "type": "array", "items": { "type": "string" } }
  }
}
